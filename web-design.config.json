{
  "schemaVersion": 1,
  "projectSlug": "ks",
  "projectChecks": [
    {
      "name": "website build",
      "command": [
        "node",
        "website/scripts/build.mjs"
      ]
    },
    {
      "name": "website tests",
      "command": [
        "node",
        "--test",
        "website/tests/site.test.mjs"
      ]
    }
  ],
  "performance": {
    "outputDirectory": "website/dist",
    "entryPages": [
      "index.html",
      "es/index.html"
    ],
    "allowedExtensions": [
      ".css",
      ".html",
      ".ico",
      ".jpg",
      ".js",
      ".json",
      ".png",
      ".svg",
      ".txt",
      ".webp",
      ".woff2",
      ".xml"
    ],
    "delivery": {
      "baseline": "website/delivery-baseline.json",
      "tolerance": 0.03,
      "connection": {
        "downloadKbps": 1600,
        "rttMs": 150
      },
      "viewport": {
        "cssWidth": 390,
        "cssHeight": 844,
        "dpr": 2
      }
    }
  }
}
